{
  "name": "olum-ui",
  "description": "Olum App",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run css && npm run snippets && concurrently -k -n css,app -c magenta,green \"npm run css:watch\" \"npm run dev:app\"",
    "build": "npm run snippets && olum-compiler build",
    "start": "olum-compiler start",
    "css": "tailwindcss -i src/main.css -o public/main.css",
    "css:watch": "npm run css -- --watch",
    "dev:app": "olum-compiler dev",
    "snippets": "node scripts/gen-snippets.mjs"
  },
  "keywords": [
    "olum"
  ],
  "author": "Eissa Saber",
  "license": "ISC",
  "dependencies": {
    "olum": "latest",
    "olum-router": "latest",
    "olum-store": "latest",
    "olum-transition": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "concurrently": "latest",
    "olum-compiler": "latest",
    "shiki": "^4.4.2",
    "tailwindcss": "latest",
    "vite": "^8.2.0"
  }
}
